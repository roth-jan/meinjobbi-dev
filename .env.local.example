# Copy this file to .env.local to override .env.development settings
# .env.local takes precedence and is NOT committed to git

# API URL - points to the Lambda backend (server-side, for Server Actions)
# Uncomment ONE of the following:

# Local development
# API_URL=http://localhost:5027
# NEXT_PUBLIC_API_URL=http://localhost:5027

# DEV environment
# API_URL=https://mxbxwlreif.execute-api.eu-central-1.amazonaws.com/default
# NEXT_PUBLIC_API_URL=https://mxbxwlreif.execute-api.eu-central-1.amazonaws.com/default

# DEMO environment (default in .env.development)
# API_URL=https://3rwgghvo8d.execute-api.eu-central-1.amazonaws.com/demo
# NEXT_PUBLIC_API_URL=https://3rwgghvo8d.execute-api.eu-central-1.amazonaws.com/demo

